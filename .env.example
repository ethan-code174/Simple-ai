# ---------- Backend (FastAPI). All variables are prefixed AIF_. ----------
AIF_ENV=development
# SQLite works with zero setup. For Postgres/Supabase use: postgresql+psycopg://user:pass@host:5432/dbname
AIF_DATABASE_URL=sqlite:///./ai_factory.db

# IMPORTANT: change this to a long random string in production (openssl rand -hex 32)
AIF_JWT_SECRET=change-me-in-production-please-32-bytes-min
# Development only: show password-reset links on screen because no email service is configured.
AIF_DEV_SHOW_RESET_TOKEN=true

# Auth mode: "local" (built-in email + password) or "supabase" (verify Supabase-issued JWTs)
AIF_AUTH_MODE=local
AIF_SUPABASE_URL=
AIF_SUPABASE_JWT_SECRET=

AIF_CORS_ORIGINS=http://localhost:3000
AIF_PUBLIC_BASE_URL=http://localhost:3000

# Local AI via Ollama (https://ollama.com). No API key.
AIF_OLLAMA_BASE_URL=http://localhost:11434
AIF_OLLAMA_DEFAULT_MODEL=llama3.2
AIF_OLLAMA_EMBED_MODEL=nomic-embed-text

# Tests/E2E only. Exposes a fake "Test mock (not AI)" provider. Never enable in production.
AIF_ENABLE_TEST_PROVIDER=false

# Limits
AIF_MAX_NODES=50
AIF_RUN_TIMEOUT_SECONDS=90
AIF_MAX_AI_CALLS_PER_RUN=5
AIF_MAX_CONCURRENT_RUNS_PER_USER=3
AIF_MAX_UPLOAD_MB=10
AIF_PUBLIC_RATE_LIMIT_PER_MINUTE=20
AIF_UPLOAD_DIR=./uploads

# ---------- Frontend (Next.js) ----------
# Where the Next.js server proxies /api/* to.
BACKEND_URL=http://127.0.0.1:8000

# ---------- Not used by the MVP (no hosted AI APIs, no payments yet) ----------
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
